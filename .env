# Read only by production settings; development settings force DEBUG=True locally.
DEBUG=False
# Real domain(s) + localhost so both production and local dev work.
ALLOWED_HOSTS=shamvainnovators.org,www.shamvainnovators.org,localhost,127.0.0.1

# Public origins for CSRF (production). MUST include scheme.
CSRF_TRUSTED_ORIGINS=https://shamvainnovators.org,https://www.shamvainnovators.org

# Force HTTPS redirect in production (behind Cloudflare Tunnel TLS).
SECURE_SSL_REDIRECT=True

# Database. Production uses SQLite (no DB server). To switch to PostgreSQL,
# set DB_ENGINE=postgresql and fill in the values below.
# DB_ENGINE=postgresql
DB_NAME=learning_platform
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail SMTP)
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Set EMAIL_HOST_USER and DEFAULT_FROM_EMAIL to the same Gmail address
# 4. Copy this file to .env and fill in the values below
# Dev uses console output until EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are set.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=shamva.innovators@gmail.com
EMAIL_HOST_PASSWORD=asrd hcem iyjh yuij
DEFAULT_FROM_EMAIL=shamva.innovators@gmail.com
ADMIN_EMAIL=shamva.innovators@gmail.com

# Optional: force a specific backend (overrides dev auto-detection)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional: require email verification during local development
REQUIRE_EMAIL_VERIFICATION=True

