SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL — used in production; dev uses SQLite)
DB_NAME=learning_platform
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (Gmail SMTP)
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Set EMAIL_HOST_USER and DEFAULT_FROM_EMAIL to the same Gmail address
# 4. Copy this file to .env and fill in the values below
# Dev uses console output until EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are set.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AI Program Zimbabwe <yourprogram@gmail.com>
ADMIN_EMAIL=yourprogram@gmail.com

# Optional: force a specific backend (overrides dev auto-detection)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Optional: require email verification during local development
# REQUIRE_EMAIL_VERIFICATION=True

# Session
SESSION_COOKIE_AGE=3600

# Seed admin (used by: python manage.py seed_admin)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
