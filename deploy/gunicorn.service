[Unit]
Description=Gunicorn for Shamva Innovators learning platform
After=network.target

[Service]
Type=simple
# --- EDIT User/Group/paths to match your server (deployed values shown) ---
User=sean
Group=sean
WorkingDirectory=/home/sean/learningPlatform
# -------------------------------------------------------------------------
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
# .env is loaded automatically by the app's load_dotenv() from WorkingDirectory.
ExecStart=/home/sean/learningPlatform/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
